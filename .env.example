# TrafficAgent 环境变量示例
# 复制为本文件为 .env 并填入实际值；.env 已被 .gitignore 忽略，不会提交。

# ============================================================
# 1. OpenAI 兼容通道（默认，支持 DeepSeek / OpenAI / Groq 等兼容接口）
# ============================================================
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=<YOUR_OPENAI_KEY>
OPENAI_CHAT_MODEL=gpt-4o-mini
# 注：TrafficAgent 默认用本地 FastEmbed 做向量化，无需配置 embeddings 模型；
# 若需切换为 OpenAI embeddings，可在 flowsettings.py 中注册。
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large

# ============================================================
# 2. Azure OpenAI（同时配置 endpoint + key 才会注册）
# ============================================================
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-35-turbo
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-ada-002

# ============================================================
# 3. Google Gemini
# ============================================================
GOOGLE_API_KEY=

# ============================================================
# 4. Cohere（LLM + 重排）
# ============================================================
COHERE_API_KEY=

# ============================================================
# 5. Mistral
# ============================================================
MISTRAL_API_KEY=

# ============================================================
# 6. 本地模型（Ollama）—— 配置 LOCAL_MODEL 即自动注册
# ============================================================
KH_OLLAMA_URL=http://localhost:11434/v1/
LOCAL_MODEL=qwen2.5:7b
LOCAL_MODEL_EMBEDDINGS=nomic-embed-text

# ============================================================
# 7. 多轮记忆（可选）
# ============================================================
# memory（默认，进程内）或 redis（多 worker 共享，需 REDIS_URL）
MEMORY_BACKEND=memory
MEMORY_MAX_TURNS=10
MEMORY_TTL=1800
REDIS_URL=redis://localhost:6379

# ============================================================
# 8. 检索链路开关（可选）
# ============================================================
USE_HYBRID_RETRIEVAL=true
USE_RERANKING=true
